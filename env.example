# AngelOne SmartAPI credentials
# Get from: https://smartapi.angelbroking.com/
ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here
ANGELONE_PASSWORD=your_login_password_here
ANGELONE_TOTP_SECRET=your_totp_base32_secret_here
# Note: TOTP secret is the BASE32 text, not the QR code URL

# Groq AI API
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Redis connection
# On Railway this is set automatically when you add Redis plugin
# For local development use: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Optional — Groww broker (for live trading phase, not needed now)
# GROWW_API_KEY=
# GROWW_CLIENT_ID=
